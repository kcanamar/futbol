---
const pathname = Astro.url.pathname;

const links = [
  { href: '/', label: 'Home' },
  { href: '/random-number/', label: 'Number' },
  { href: '/random-color/', label: 'Color' },
  { href: '/arrows/', label: 'Arrows' },
  { href: '/double-cue/', label: 'Combo' },
  { href: '/interval-timer/', label: 'Timer' },
];
---

<nav class="nav">
  <div class="nav-inner">
    {links.map(link => (
      <a
        href={link.href}
        class:list={['nav-link', { active: pathname === link.href }]}
      >
        {link.label}
      </a>
    ))}
  </div>
</nav>

<style>
  .nav {
    background-color: var(--color-primary);
    position: sticky;
    top: 0;
    z-index: 100;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .nav::-webkit-scrollbar {
    display: none;
  }

  .nav-inner {
    display: flex;
    gap: 2px;
    padding: 0.5rem;
    min-width: max-content;
  }

  .nav-link {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 0.5rem 0.75rem;
    color: rgba(255, 255, 255, 0.75);
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 500;
    border-radius: 8px;
    transition: background-color 0.2s, color 0.2s;
    white-space: nowrap;
  }

  .nav-link:hover {
    background-color: rgba(255, 255, 255, 0.1);
    color: white;
  }

  .nav-link.active {
    background-color: rgba(255, 255, 255, 0.2);
    color: white;
  }
</style>
